# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.sqlite3
*.db
.venv/
.pytest_cache/

# Node
node_modules/
frontend/dist/
*.tsbuildinfo

# Env
.env
backend/.env
frontend/.env

# Logs
backend/logs/

# OS
.DS_Store

# Tooling
.playwright-mcp/

# Claude Code / Archie runtime
# Ignore everything in .claude/ then selectively un-ignore config files
.claude/*
!.claude/CLAUDE.md
!.claude/runtime/
.claude/runtime/*
!.claude/runtime/.claude/
.claude/runtime/.claude/*
!.claude/runtime/.claude/CLAUDE.md
!.claude/runtime/.claude/skills/

# Docker
*.tar

# Kronos forecasting — model weights are pulled from Hugging Face at
# runtime, not committed. Ignore HF cache and demo-script plot output.
.cache/huggingface/
backend/kronos_forecast_*.png

# Long-running server logs/pids (scripts/serve.sh)
.run/

# Also ignore a node_modules symlink (the trailing-slash pattern above only matches directories)
node_modules

# Sandbox broker state (local mock T212)
backend/sandbox_state.json
sandbox_state.json

# Internal planning notes (kept locally, not published)
docs/plans/
docs/superpowers/
docs/reviews/

# Demo sandbox data
.demo/

# Views (agent-built pages; user data)
backend/data/views/

# Recipes made by you or Archie (personal data; built-ins ship in backend/app/recipes_builtin)
backend/data/recipes/

# Company logo cache (fetched once by the server; see docs/logos.md)
backend/data/logos/

# Connection secrets key (encrypts broker/exchange keys at rest) — back it up with the DB, never commit it
openpf-secrets.key
*.secrets.key
