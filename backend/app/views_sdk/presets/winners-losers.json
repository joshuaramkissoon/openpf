{
  "version": 1,
  "title": "Winners & losers",
  "description": "What's made and lost me money? Every holding's gain or loss since you bought",
  "icon": "trending-up",
  "controls": {"account": true},
  "data": {"pf": {"source": "portfolio"}},
  "blocks": [
    {
      "type": "hero",
      "label": "Unrealised gain",
      "from": "pf.positions",
      "value": {"agg": "sum", "field": "ppl"},
      "format": "signedMoney",
      "delta": {"agg": "sum", "field": "ppl", "per": {"agg": "sum", "field": "cost"}},
      "deltaFormat": "signedPct",
      "deltaLabel": "on what you paid",
      "caption": "Across everything you still hold. Realised gains from sales aren't included.",
      "width": "two-thirds"
    },
    {
      "type": "kpis",
      "from": "pf.positions",
      "width": "third",
      "items": [
        {"label": "In profit", "value": {"agg": "count", "transform": [{"filter": {"field": "ppl", "op": ">", "value": 0}}]}, "format": "int", "hint": "holdings above what you paid"},
        {"label": "Under water", "value": {"agg": "count", "transform": [{"filter": {"field": "ppl", "op": "<", "value": 0}}]}, "format": "int", "hint": "holdings below what you paid"}
      ]
    },
    {
      "type": "treemap",
      "title": "Return on cost",
      "subtitle": "Each holding sized by value, coloured by its % gain or loss since you bought",
      "from": "pf.positions",
      "label": "ticker",
      "size": "value",
      "color": "ppl_pct",
      "colorFormat": "signedPct"
    },
    {
      "type": "bars",
      "title": "Gain or loss in pounds",
      "subtitle": "Every holding, best to worst",
      "from": "pf.positions",
      "transform": [{"sort": {"by": "ppl", "dir": "desc"}}],
      "label": "ticker",
      "value": "ppl",
      "format": "signedMoney",
      "secondary": "ppl_pct",
      "secondaryFormat": "signedPct",
      "limit": 30,
      "details": [
        {"field": "value", "label": "Value", "format": "money"},
        {"field": "cost", "label": "Cost", "format": "money"},
        {"field": "day_change_pct", "label": "Today", "format": "signedPct"}
      ]
    }
  ]
}
