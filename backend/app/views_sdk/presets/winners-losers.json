{
  "version": 1,
  "title": "Winners & losers",
  "description": "What's made and lost you money since you bought, and how each name is doing today",
  "icon": "trending-up",
  "controls": {"account": true},
  "data": {"pf": {"source": "portfolio"}},
  "blocks": [
    {
      "type": "kpis",
      "from": "pf.positions",
      "items": [
        {"label": "Unrealised gain", "value": {"agg": "sum", "field": "ppl"}, "format": "signedMoney", "delta": {"agg": "sum", "field": "ppl", "per": {"agg": "sum", "field": "cost"}}, "deltaFormat": "signedPct", "hint": "on cost"},
        {"label": "In profit", "value": {"agg": "count", "transform": [{"filter": {"field": "ppl", "op": ">", "value": 0}}]}, "format": "int", "hint": "holdings above cost"},
        {"label": "Under water", "value": {"agg": "count", "transform": [{"filter": {"field": "ppl", "op": "<", "value": 0}}]}, "format": "int", "hint": "holdings below cost"},
        {"label": "Best performer", "value": {"agg": "max", "field": "ppl_pct"}, "format": "signedPct", "hint": "return on cost"}
      ]
    },
    {
      "type": "bars",
      "title": "Gain or loss since purchase",
      "subtitle": "Every holding, best to worst",
      "from": "pf.positions",
      "transform": [{"sort": {"by": "ppl", "dir": "desc"}}],
      "label": "ticker",
      "value": "ppl",
      "format": "signedMoney",
      "secondary": "ppl_pct",
      "secondaryFormat": "signedPct",
      "limit": 30,
      "details": [
        {"field": "value", "label": "Value", "format": "money"},
        {"field": "cost", "label": "Cost", "format": "money"},
        {"field": "day_change_pct", "label": "Today", "format": "signedPct"}
      ],
      "width": "half"
    },
    {
      "type": "treemap",
      "title": "Return on cost",
      "subtitle": "Sized by value, coloured by % gain since you bought",
      "from": "pf.positions",
      "label": "ticker",
      "size": "value",
      "color": "ppl_pct",
      "colorFormat": "signedPct",
      "width": "half"
    }
  ]
}
