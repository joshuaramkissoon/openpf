{
  "version": 1,
  "title": "Where's my risk",
  "description": "How much rides on a few names, sectors and countries",
  "icon": "shield",
  "controls": {"account": true},
  "data": {"pf": {"source": "portfolio"}},
  "blocks": [
    {
      "type": "kpis",
      "from": "pf.positions",
      "items": [
        {"label": "Largest holding", "value": {"agg": "max", "field": "weight"}, "format": "pct", "hint": "of everything, cash included"},
        {"label": "Top 5", "value": {"agg": "sum", "field": "weight", "transform": [{"sort": {"by": "value"}}, {"top": {"n": 5}}]}, "format": "pct", "hint": "share in five names"},
        {"label": "Holdings", "value": {"agg": "count"}, "format": "int", "hint": "positions across accounts"},
        {"label": "Cash", "value": {"from": "pf.metrics", "field": "cash_ratio"}, "format": "pct", "hint": "uninvested"}
      ]
    },
    {
      "type": "treemap",
      "title": "Concentration map",
      "subtitle": "Holdings sized by value and grouped by sector; colour is gain or loss since you bought. Click a sector to drill in.",
      "from": "pf.positions",
      "transform": [{"enrich": ["sector"]}],
      "label": "ticker",
      "size": "value",
      "color": "ppl_pct",
      "colorFormat": "signedPct",
      "group": "sector"
    },
    {
      "type": "allocation",
      "title": "Sector mix",
      "subtitle": "Funds are grouped together; click a sector to see its holdings",
      "from": "pf.positions",
      "transform": [{"enrich": ["sector"]}, {"groupBy": "sector"}, {"sort": {"by": "value"}}],
      "label": "sector",
      "value": "value",
      "width": "half"
    },
    {
      "type": "allocation",
      "title": "Country mix",
      "subtitle": "Where the companies you own are based",
      "from": "pf.positions",
      "transform": [{"enrich": ["country"]}, {"groupBy": "country"}, {"sort": {"by": "value"}}],
      "label": "country",
      "value": "value",
      "width": "half"
    },
    {
      "type": "bars",
      "title": "Largest positions",
      "subtitle": "Share of the whole portfolio",
      "from": "pf.positions",
      "transform": [{"sort": {"by": "weight"}}, {"top": {"n": 10}}],
      "label": "ticker",
      "value": "weight",
      "format": "pct",
      "secondary": "ppl_pct",
      "secondaryFormat": "signedPct"
    }
  ]
}
