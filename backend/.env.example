# OpenPF backend settings. Copy to backend/.env and fill in what you need.
# Everything is optional except a way to reach Claude (see "Claude" below).
# Broker and exchange keys are best added in the app (Settings → Connections),
# where they're stored in the database and connection secrets are encrypted.

# ── App ─────────────────────────────────────────────────────────────────────
APP_ENV=dev
APP_NAME=OpenPF
DATABASE_URL=sqlite:///./openpf.db
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\\.0\\.0\\.1)(:\\d+)?$
# Require this token on the API and chat. Set it before exposing OpenPF beyond localhost.
OPENPF_API_TOKEN=
# How Archie addresses you (optional)
OPENPF_USER_NAME=
PORTFOLIO_DISPLAY_CURRENCY=GBP

# ── Claude (Archie) ─────────────────────────────────────────────────────────
# One of these, checked in this order:
#   1. CLAUDE_CODE_OAUTH_TOKEN — from `claude setup-token` (uses your Claude plan;
#      when set, ANTHROPIC_API_KEY is ignored for the agent)
#   2. ANTHROPIC_API_KEY — pay-as-you-go API key from console.anthropic.com
#   3. neither: the bundled Claude Code CLI uses your existing `claude` login on this machine
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# ── Optional providers ──────────────────────────────────────────────────────
# Fast view building on Together AI (also settable in Settings → Data providers).
# Without it, views are built with Claude; with neither, you get the closest preset.
TOGETHER_API_KEY=
# Smart money (insider Form 4 / 13F): the SEC requires a contact email in the User-Agent.
SEC_CONTACT_EMAIL=
FINNHUB_API_KEY=
NEWSAPI_API_KEY=

# ── Trading 212 ─────────────────────────────────────────────────────────────
# demo (default) | live | sandbox. Settings → Broker & keys overrides these once saved.
T212_BASE_ENV=demo
# Read keys (one per account)
T212_INVEST_API_KEY=
T212_INVEST_API_SECRET=
T212_STOCKS_ISA_API_KEY=
T212_STOCKS_ISA_API_SECRET=
# Optional execution keys (ideally IP-restricted). Only the API server ever holds these.
T212_EXEC_API_KEY_INVEST=
T212_EXEC_API_SECRET_INVEST=
T212_EXEC_API_KEY_STOCKS_ISA=
T212_EXEC_API_SECRET_STOCKS_ISA=

# ── Execution safety (Settings → Risk rails overrides these) ────────────────
BROKER_MODE=paper
MAX_SINGLE_ORDER_NOTIONAL=500
MAX_DAILY_NOTIONAL=1500
MAX_POSITION_WEIGHT=0.25
MAX_CRYPTO_PCT_OF_BOOK=0.05
DUPLICATE_ORDER_WINDOW_SECONDS=90

# ── Agent runtime ───────────────────────────────────────────────────────────
CLAUDE_SETTING_SOURCES=project
CLAUDE_PROJECT_CWD=.claude/runtime
# true = run recipes and schedules inside the API process (Docker runs a separate worker instead)
INPROC_SCHEDULER_ENABLED=false
